+
+describe("derivePromptCacheStatus", () => {
+  const updatedAt = "2026-10-07T20:00:00.000Z";
+  const reportedAtMs = Date.parse(updatedAt);
+
+  it("reports the cache hit share and stays warm inside the TTL", () => {
+    expect(
+      derivePromptCacheStatus(
+        { inputTokens: 200_000, cachedInputTokens: 194_000, updatedAt },
+        reportedAtMs + 59 * 60_000,
+      ),
+    ).toEqual({ hitPercentage: 97, expiresAtMs: reportedAtMs + 3_600_000, warm: true });
+  });
+
+  it("turns cold once the TTL has passed", () => {
+    expect(
+      derivePromptCacheStatus(
+        { inputTokens: 1_000, cachedInputTokens: 0, updatedAt },
+        reportedAtMs + 3_600_000,
+      )?.warm,
+    ).toBe(false);
+  });
+
+  it("has no hit share when the provider reports no input", () => {
+    expect(
+      derivePromptCacheStatus({ inputTokens: null, cachedInputTokens: null, updatedAt }, 0)
+        ?.hitPercentage,
+    ).toBeNull();
+  });
+
+  it("returns null for an unparseable timestamp", () => {
+    expect(
+      derivePromptCacheStatus({ inputTokens: 1, cachedInputTokens: 1, updatedAt: "nope" }, 0),
+    ).toBeNull();
+  });
+});
