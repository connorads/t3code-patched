+++ b/apps/web/src/components/chat/ContextWindowMeter.logic.ts
@@ -143,3 +143,32 @@ export function formatContextWindowCost(cost: {
   const fractionDigits = Math.abs(cost.amount) > 0 && Math.abs(cost.amount) < 0.01 ? 4 : 2;
   return `${cost.currency} ${cost.amount.toFixed(fractionDigits)}`;
 }
+
+/** Claude subscription prompt-cache lifetime; API keys and overage get 5 minutes. */
+export const PROMPT_CACHE_TTL_MS = 60 * 60 * 1000;
+
+export type PromptCacheStatus = {
+  /** Share of the last request's input read from cache, 0-100; null when unreported. */
+  readonly hitPercentage: number | null;
+  readonly expiresAtMs: number;
+  readonly warm: boolean;
+};
+
+export function derivePromptCacheStatus(
+  usage: {
+    readonly inputTokens?: number | null | undefined;
+    readonly cachedInputTokens?: number | null | undefined;
+    readonly updatedAt: string;
+  },
+  nowMs: number,
+  ttlMs: number = PROMPT_CACHE_TTL_MS,
+): PromptCacheStatus | null {
+  const reportedAtMs = Date.parse(usage.updatedAt);
+  if (!Number.isFinite(reportedAtMs)) return null;
+  const hitPercentage =
+    usage.inputTokens != null && usage.inputTokens > 0 && usage.cachedInputTokens != null
+      ? Math.min(100, (usage.cachedInputTokens / usage.inputTokens) * 100)
+      : null;
+  const expiresAtMs = reportedAtMs + ttlMs;
+  return { hitPercentage, expiresAtMs, warm: nowMs < expiresAtMs };
+}
